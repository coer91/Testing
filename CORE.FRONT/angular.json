{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "packageManager": "npm"
    },
    "newProjectRoot": "projects",
    "projects": {
        "hwmx-core-frontend": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src/config/",
            "prefix": "app",
            "architect": {
                "build": {                      
                    "builder": "@angular/build:application",
                    "options": {
                        "browser": "src/config/main.ts",
                        "tsConfig": "tsconfig.json",
                        "assets": [
                            { "glob": "**/*", "input": "./public" },
                            { "glob": "**/*", "input": "./public/hwmx-angular/images", "output": "/hwmx-angular/images" },         
                            { "glob": "manifest.webmanifest", "input": "./src/config" },              
                            { "glob": "appSettings.js", "input": "./src/config" }                            
                        ],
                        "styles": [
                            "./node_modules/bootstrap-icons/font/bootstrap-icons.min.css",
                            "./node_modules/@fortawesome/fontawesome-free/css/all.min.css",
                            "./public/hwmx-angular/styles/lib/hwmx-angular.css"
                        ],
                        "stylePreprocessorOptions": { "includePaths": ["."] },
                        "inlineStyleLanguage": "scss"                                 
                    },
                    "configurations": {
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "staging": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "10mb",
                                    "maximumError": "10mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb",
                                    "maximumError": "10kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/config/environments/env.development.ts",
                                    "with": "src/config/environments/env.staging.ts"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "10mb",
                                    "maximumError": "10mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "10kb",
                                    "maximumError": "10kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/config/environments/env.development.ts",
                                    "with": "src/config/environments/env.production.ts"
                                }
                            ],
                            "outputHashing": "all" 
                        } 
                    },
                    "defaultConfiguration": "staging"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "development": {
                            "buildTarget": "hwmx-core-frontend:build:development"
                        },
                        "staging": {
                            "buildTarget": "hwmx-core-frontend:build:staging"
                        },
                        "production": {
                            "buildTarget": "hwmx-core-frontend:build:production"
                        }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    }
}
